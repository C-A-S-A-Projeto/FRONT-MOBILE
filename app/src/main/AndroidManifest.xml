<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".CasaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_logo_casa"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo_casa"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjetoCasa"
        tools:targetApi="31">

        <!-- Tela Inicial / Principal -->
        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Demais telas do aplicativo -->
        <activity
            android:name=".view.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.CadastroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".view.CategoriaItemActivity"
            android:exported="false" />

        <activity
            android:name=".view.CategoriaBotaoActivity"
            android:exported="false" />

        <activity
            android:name=".view.CategoriaGeralActivity"
            android:exported="false" />

        <activity
            android:name=".view.ConfiguracoesActivity"
            android:exported="false" />

        <activity
            android:name=".view.DesempenhoActivity"
            android:exported="false" />

        <activity
            android:name=".view.HistoricoActivity"
            android:exported="false" />

        <activity
            android:name=".view.NotificacoesActivity"
            android:exported="false" />

        <activity
            android:name=".view.PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".view.ExcluirContaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.RedefinirSenhaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.DesconectarContaActivity"
            android:exported="false" />

        <activity
            android:name=".view.ValidarContaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BemVindoActivity"
            android:exported="false" />

        <!-- FileProvider para compartilhamento seguro de documentos PDF -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Configuração de Notificações com Firebase Cloud Messaging -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/baseline_home_24" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_primary" />

    </application>

</manifest>
