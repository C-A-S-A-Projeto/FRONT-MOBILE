<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- 1. Banner com Gradiente e Título Ajustado mais para baixo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBannerCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_banner"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Categorias"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Crie, edite ou elimine categorias. Personalize os botões de cada uma."
                    android:textColor="#F1F5F9"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Botão de Criar Categoria + Busca -->
        <LinearLayout
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+ Adicionar Categoria"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="8dp"
                tools:ignore="TouchTargetSizeCheck" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@android:color/white"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#CBD5E1"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="#64748B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="Busque por uma categoria..."
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- 3. Card 1: Escola -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnEditarCategoria1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editar Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#64748B" />

                        <ImageView
                            android:id="@+id/btnExcluirCategoria1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Excluir Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#EF4444" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/txtNomeCategoria1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escola"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgCategoria1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Imagem da Categoria Escola"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_agenda" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcessarCategoria1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Acessar Categoria"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#5C82F2"
                    app:cornerRadius="6dp"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Card 2: Casa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnEditarCategoria2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editar Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#64748B" />

                        <ImageView
                            android:id="@+id/btnExcluirCategoria2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Excluir Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#EF4444" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/txtNomeCategoria2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casa"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgCategoria2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Imagem da Categoria Casa"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_home_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcessarCategoria2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Acessar Categoria"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#5C82F2"
                    app:cornerRadius="6dp"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Card 3: Objetos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnEditarCategoria3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editar Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#64748B" />

                        <ImageView
                            android:id="@+id/btnExcluirCategoria3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Excluir Categoria"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#EF4444" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/txtNomeCategoria3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Objetos"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgCategoria3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Imagem da Categoria Objetos"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_preferences" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcessarCategoria3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="32dp"
                    android:text="Acessar Categoria"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    app:backgroundTint="#5C82F2"
                    app:cornerRadius="6dp"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>