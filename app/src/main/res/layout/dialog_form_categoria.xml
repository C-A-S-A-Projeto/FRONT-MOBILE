<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerenciar Categoria"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="14dp"/>

        <!-- Título da Categoria -->
        <EditText
            android:id="@+id/etCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título da Categoria (Ex: Escola, Casa)"
            android:inputType="textCapSentences"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="14dp"/>

        <!-- Seção de Imagem da Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imagem da Categoria"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/ivCategoryPreview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_default_button"
                android:scaleType="centerCrop"
                android:background="@color/card_surface_secondary"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCategoryPhoto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Galeria de Fotos"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/brand_primary"
                    android:layout_marginBottom="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCategoryDrawing"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Desenhos C.A.S.A. (Drive)"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    app:icon="@android:drawable/ic_menu_today"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/brand_primary"
                    android:layout_marginBottom="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDefaultCategoryImg"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Imagem Padrão"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Seção de Áudio da Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Áudio da Categoria"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtCategoryAudioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_surface_secondary"
            android:padding="6dp"
            android:text="Nenhum áudio selecionado (lê o título por padrão)."
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectCategoryAudio"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolher Áudio do Dispositivo"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart"
            app:iconSize="14dp"
            app:iconTint="@color/brand_primary"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordCategoryAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gravar Voz"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/danger_red"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@android:color/white"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopCategoryAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parar"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="#B91C1C"
                app:icon="@android:drawable/ic_media_pause"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@android:color/white"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewCategoryAudio"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prévia"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@color/brand_primary"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Escolha de Voz Padrão (TTS) para a Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ou escolha a voz padrão:"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rgCategoryGenderVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbCategoryFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feminino"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbCategoryMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:text="Masculino"/>
        </RadioGroup>

        <!-- Barra de Progresso de Upload -->
        <ProgressBar
            android:id="@+id/progressCategoryModal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Botão Salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Categoria"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
