<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

    <!-- Header com Gradiente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_banner"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:soundEffectsEnabled="true"
                app:tint="@android:color/white" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Ícone de Notificações"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/txtTitleNotificacoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Notificações e Avisos"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimparNotificacoes"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@android:color/white"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtSubtituloNotificacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Monitoramento em tempo real do dispositivo e acionamentos"
            android:textColor="#F1F5F9"
            android:textSize="12sp" />

        <!-- Card de Status do Dispositivo em Tempo Real -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusDispositivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E3A8A"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#3B82F6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <View
                    android:id="@+id/dotStatusDispositivo"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_circulo_verde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusDispositivoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dispositivo Conectado"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusDispositivoDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESP32 C.A.S.A. • Bateria: 100% • Online"
                        android:textColor="#BFDBFE"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgIconeBateria"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_idle_charging"
                    app:tint="#10B981" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Barra de Progresso -->
    <ProgressBar
        android:id="@+id/progressBarNotificacoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Estado Vazio -->
    <LinearLayout
        android:id="@+id/layoutSemNotificacoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Sem notificações"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/txtSemNotificacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhuma notificação por enquanto."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Eventos do dispositivo e acionamentos aparecerão aqui em tempo real."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- RecyclerView de Notificações -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotificacoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Botão Fechar no rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/card_surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFecharNotificacoes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fechar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
