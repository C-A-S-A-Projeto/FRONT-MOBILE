<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- 1. Banner com Gradiente Laranja -> Azul -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBannerConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_banner"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Configurações"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Personalize o comportamento do app, temas e acessibilidade."
                    android:textColor="#F1F5F9"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. SEÇÃO: SISTEMA -->
        <TextView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Sistema"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/card_surface_secondary"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Ativar / Desativar: Notificações -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativar/Desativar"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:drawablePadding="8dp"
                            android:text="Notificações"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@android:drawable/ic_popup_reminder"
                            app:drawableTint="@color/brand_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchNotificacoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true"
                            tools:ignore="TouchTargetSizeCheck" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Termos e Regras -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Termos e Regras"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <!-- Item 1: Termos de Privacidade -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnTermosPrivacidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:padding="10dp"
                        android:text="Termos de privacidade"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_agenda"
                        app:drawableTint="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: Informações -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnInformacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:padding="10dp"
                        android:text="Informações"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_info_details"
                        app:drawableTint="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 3: Suporte -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSuporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:padding="10dp"
                        android:text="Suporte"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_help"
                        app:drawableTint="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. SEÇÃO: ACESSIBILIDADE -->
        <TextView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Acessibilidade"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_surface_secondary"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Modo Claro/Escuro -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo Claro/Escuro"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:drawablePadding="8dp"
                            android:text="Modo Escuro"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@android:drawable/ic_menu_compass"
                            app:drawableTint="@color/text_secondary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchModoEscuro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            tools:ignore="TouchTargetSizeCheck" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Feedback Sonoro nos Botões -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Efeitos Sonoros de Toque"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:drawablePadding="8dp"
                            android:text="Som ao Clicar nos Botões"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@android:drawable/ic_lock_silent_mode_off"
                            app:drawableTint="@color/brand_primary" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSoundFeedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true"
                            android:soundEffectsEnabled="true"
                            tools:ignore="TouchTargetSizeCheck" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tamanho da Fonte -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tamanho da Fonte"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="Escala de Texto"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDiminuirFonte"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:minWidth="32dp"
                                    android:minHeight="32dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:soundEffectsEnabled="true"
                                    android:text="-"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    app:cornerRadius="6dp"
                                    tools:ignore="TouchTargetSizeCheck" />

                                <TextView
                                    android:id="@+id/txtTamanhoFonte"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="8dp"
                                    android:text="100% (Padrão)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAumentarFonte"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:minWidth="32dp"
                                    android:minHeight="32dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:soundEffectsEnabled="true"
                                    android:text="+"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    app:cornerRadius="6dp"
                                    tools:ignore="TouchTargetSizeCheck" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Slider Interativo para Escala Contínua/Suave -->
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderTamanhoFonte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:contentDescription="Controle de tamanho da fonte"
                            android:stepSize="0.15"
                            android:value="1.0"
                            android:valueFrom="0.85"
                            android:valueTo="1.30"
                            app:thumbColor="@color/brand_primary"
                            app:trackColorActive="@color/brand_primary"
                            app:trackColorInactive="@color/card_stroke" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
