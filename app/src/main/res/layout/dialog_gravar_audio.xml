<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloGravador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gravar Mensagem de Voz"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusGravador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gravando áudio de voz..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Ícone Pulsante de Microfone -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/viewGlowMic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circulo_verde"
                android:alpha="0.25" />

            <ImageView
                android:id="@+id/imgMicGravador"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/danger_red" />
        </FrameLayout>

        <!-- Cronômetro Estilo WhatsApp (00:00) -->
        <Chronometer
            android:id="@+id/chronometerGravacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="%s"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="00:15" />

        <!-- Visualizador de Onda Sonora (Waveform) -->
        <fatec.labweb.projetocasa.view.AudioWaveformView
            android:id="@+id/waveformView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Botões de Ação estilo WhatsApp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDescartarGravacao"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textColor="@color/danger_red"
                android:soundEffectsEnabled="true"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/danger_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPararOuPrevia"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Parar"
                android:textColor="@color/text_primary"
                android:soundEffectsEnabled="true"
                app:icon="@android:drawable/ic_media_pause"
                app:iconTint="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarAudio"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Salvar"
                android:textColor="@android:color/white"
                android:soundEffectsEnabled="true"
                app:backgroundTint="@color/brand_primary"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
