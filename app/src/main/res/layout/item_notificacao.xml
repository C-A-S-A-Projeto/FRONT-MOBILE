<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotificacao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Ícone Redondo com Fundo Colorido -->
        <FrameLayout
            android:id="@+id/flIconeNotificacao"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circulo_verde">

            <ImageView
                android:id="@+id/imgIconeNotificacao"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/brand_primary"
                android:contentDescription="Ícone de Notificação" />
        </FrameLayout>

        <!-- Informações de Conteúdo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtTituloNotificacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Novo Acionamento" />

                <TextView
                    android:id="@+id/txtTagTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#DBEAFE"
                    android:textColor="#1E40AF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    tools:text="DISPOSITIVO" />

                <!-- Ponto indicador de não lida -->
                <View
                    android:id="@+id/dotNaoLida"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_red"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtMensagemNotificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="O botão 'Água' foi pressionado pelo dispositivo conectado." />

            <TextView
                android:id="@+id/txtDataNotificacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                tools:text="Hoje às 14:32" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExcluirNotificacao"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted"
            android:contentDescription="Remover notificação" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
