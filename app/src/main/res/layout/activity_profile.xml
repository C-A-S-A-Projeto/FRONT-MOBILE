<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".view.PerfilActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título da Tela -->
        <TextView
            android:id="@+id/tvTitleProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meu Perfil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtítulo / Email -->
        <TextView
            android:id="@+id/tvEmailProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="usuario@exemplo.com"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tvTitleProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Container da Foto de Perfil Circular -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_surface"
            app:layout_constraintTop_toBottomOf="@id/tvEmailProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                android:contentDescription="Foto de perfil" />
        </androidx.cardview.widget.CardView>

        <!-- Indicador de progresso durante upload de foto -->
        <ProgressBar
            android:id="@+id/progressUploadAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="@id/cardProfileImage"
            app:layout_constraintBottom_toBottomOf="@id/cardProfileImage"
            app:layout_constraintStart_toStartOf="@id/cardProfileImage"
            app:layout_constraintEnd_toEndOf="@id/cardProfileImage" />

        <!-- Botão Flutuante para Alterar Foto -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_menu_camera"
            app:backgroundTint="@color/brand_primary"
            app:tint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/cardProfileImage"
            app:layout_constraintEnd_toEndOf="@id/cardProfileImage" />

        <!-- Campo de Texto para Editar o Nome -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Nome completo"
            app:boxStrokeColor="@color/brand_primary"
            app:hintTextColor="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/cardProfileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botão Salvar Nome -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveName"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Salvar Dados do Perfil"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/tilName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão Redefinir Senha -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPassword"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Redefinir Senha"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/card_stroke"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_lock_lock"
            app:iconTint="@color/brand_primary"
            app:layout_constraintTop_toBottomOf="@id/btnSaveName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão Excluir Conta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Excluir Conta Permanentemente"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/danger_red"
            app:strokeColor="@color/danger_red"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@color/danger_red"
            app:layout_constraintTop_toBottomOf="@id/btnResetPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
