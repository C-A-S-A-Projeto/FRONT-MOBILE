<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <!-- 1. Banner Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_stroke_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/brand_primary_light"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ícone Histórico"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/brand_primary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Histórico de Uso"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Registro em tempo real de toques e acionamentos"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimparTodoHistorico"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Limpar"
                android:textAllCaps="false"
                android:textColor="@color/danger_red"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="@color/danger_red" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Filtro de Período e Busca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Campo de Busca -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/card_surface"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/card_stroke"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscarHistorico"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Buscar por botão ou categoria..."
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtros Rápidos de Período -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroTodos"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="Todos"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroHoje"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="Hoje"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/card_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroSemana"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="Semana"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/card_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroMes"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="Mês"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/card_stroke" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBarHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- 4. Estado Vazio -->
    <LinearLayout
        android:id="@+id/layoutSemHistorico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Sem histórico"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhum acionamento registrado"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Os toques realizados nos botões do aparelho ESP32 ou no aplicativo aparecerão aqui."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 5. Lista de Acionamentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

</LinearLayout>
